{
  "name": "squipix/laravel-menus",
  "description": "Laravel Menu management",
  "version": "1.0.0",
  "keywords": [
    "laravel",
    "menus",
    "navigation",
    "nav",
    "bootstrap"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Nicolas Widart",
      "email": "n.widart@gmail.com"
    },
    {
      "name": "Pingpong Labs",
      "email": "pingpong.labs@gmail.com"
    },
    {
      "name": "Anas Naguib",
      "email": "anas@squipix.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "illuminate/config": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "illuminate/view": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "squipix/html": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "mockery/mockery": "^1.6",
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
    "friendsofphp/php-cs-fixer": "^2.16|^3.0"
  },
  "autoload": {
    "psr-4": {
      "Squipix\\Menus\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Squipix\\Menus\\Tests\\": "Tests"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev"
    },
    "laravel": {
      "providers": [
        "Squipix\\Menus\\MenusServiceProvider"
      ],
      "aliases": {
        "Menu": "Squipix\\Menus\\Facades\\Menu"
      }
    }
  },
  "minimum-stability": "stable"
}